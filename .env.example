# --- Option A: local model via oMLX (free, private) ---
# Key is read from the API_KEY_LLM environment variable.
LLM_BASE_URL=http://localhost:8001
LLM_MODEL=Qwen3.6-35B-A3B-MLX-4bit
# on = the model reasons before acting (better, slower). off = faster, fewer tokens.
LLM_THINKING=on
# Stop an agent when its conversation passes this many tokens (local default 24000).
# LLM_CONTEXT_BUDGET=24000

# --- Option B: Claude in the cloud ---
# Empty LLM_BASE_URL above, set LLM_MODEL=claude-sonnet-5-5, and fill in:
ANTHROPIC_API_KEY=your-key-here
